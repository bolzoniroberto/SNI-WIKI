# Postgres
POSTGRES_DB=wiki
POSTGRES_USER=wiki
POSTGRES_PASSWORD=change-me

# Wiki.js API token (generate from Wiki.js admin UI: Administration > API Access)
WIKIJS_TOKEN=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_HEAVY=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-004

# Public hostname (used by Caddy)
SITE_HOSTNAME=wiki.local
